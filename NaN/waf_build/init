#!/usr/bin/env bash

echo Hello!

# TODO Check git, find, python, coreutils and bash

PROJECT_ROOT=$(realpath $(dirname ${BASH_SOURCE[0]})/..)
WAF_GIT_DIR=$PROJECT_ROOT/waf_build/waf_git
WAF_GIT_URL='https://gitlab.com/ita1024/waf.git'
WAF_GIT_BRANCH=master
WAF_TOOLS_DIR=$PROJECT_ROOT/waf_build/waf_tools
WAF_EXTRAS_DIR=$PROJECT_ROOT/waf_build/waf_extras
WSCRIPTS_DIR=$PROJECT_ROOT/waf_build/wscripts

FORCE=0
CLEAN=0

for PARAM in $@; do
    case $PARAM in
	-f|--force)
	    FORCE=1
	    ;;
	-c|--clean)
	    CLEAN=1
	    ;;
	-h|--help)
	    echo Help message
	    exit
	    ;;
    esac
done

WSCRIPTS_LIST=

if (( $FORCE && $CLEAN )); then
    echo Clean WAF
    rm -rf $WAF_GIT_DIR
    mkdir $WAF_GIT_DIR
fi

if (( $CLEAN || $FORCE )); then
    echo Clean symlinks
    find $PROJECT_ROOT -type l -name wscript -delete
fi

if (( ! $CLEAN )); then
    echo Search wscript files
    pushd $WSCRIPTS_DIR
    WSCRIPTS_LIST=$(find . -name wscript)
    popd
fi

if [[ ! -d $WAF_GIT_DIR/.git ]]; then
    echo Setup waf git directory
    git clone $WAF_GIT_URL $WAF_GIT_DIR
    pushd $WAF_GIT_DIR/waflib/Tools
    for TGT in $(find $WAF_TOOLS_DIR -name '*.py'); do # FIXME May be use `find` ?
	# ln -s $(realpath --relative-to=$(pwd) $TGT) # DELETEME
	ln -sr $TGT
    done
    popd
    pushd $WAF_GIT_DIR/waflib/extras
    for TGT in $(find $WAF_EXTRAS_DIR -name '*.py'); do # FIXME May be use `find` ?
        # ln -s $(realpath --relative-to=$(pwd) $TGT) # DELETEME
	ln -sr $TGT
    done
    popd
fi

if [[ ! -x $PROJECT_ROOT/waf ]]; then
    echo Setup waf executable
    echo "#!/usr/bin/env bash" > $PROJECT_ROOT/waf
    echo "WAFDIR=$WAF_GIT_DIR/waflib" >> $PROJECT_ROOT/waf
    echo './waf_build/waf_git/waf-light $@' >> $PROJECT_ROOT/waf
    chmod +x $PROJECT_ROOT/waf
fi


for WS in $WSCRIPTS_LIST; do # FIXME May be use `find` ?
    if [[ ! -L ${PROJECT_ROOT}/${WS} ]]; then
	echo Create symlink $WS
	pushd $(dirname ${PROJECT_ROOT}/${WS})
	# ln -s $(realpath --relative-to=$(pwd) $WSCRIPTS_DIR/$WS) # DELETEME
	ln -sr $WSCRIPTS_DIR/$WS
	popd
    fi
done

echo Done
